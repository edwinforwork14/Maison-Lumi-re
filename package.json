{
  "name": "maison-lumiere",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"tests/*.test.ts\"",
    "test:db": "node scripts/test-db.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "db:seed": "node --experimental-strip-types scripts/db-seed.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:reset-stock": "node --experimental-strip-types --env-file-if-exists=.env scripts/db-reset-stock.mjs",
    "vercel-build": "pnpm db:migrate && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.121.0",
    "@tanstack/react-start": "^1.168.60",
    "drizzle-orm": "^0.45.3",
    "nitro": "3.0.261103-rc",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.0",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
