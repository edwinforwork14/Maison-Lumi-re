# Fuente de datos: in-memory | postgres
DATA_SOURCE=postgres

# ─── Supabase (recomendado para producción en Vercel) ─────────────────────
# Conexión directa (para migraciones/seed desde local):
# DATABASE_URL=postgres://postgres.<REF>:<PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
#
# Pooler (para la app serverless en Vercel):
# DATABASE_URL=postgres://postgres.<REF>:<PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# URL pública del sitio (canónicas, enlaces en emails, webhooks)
PUBLIC_SITE_URL=http://localhost:3000

# Firma de cookies de sesión (mínimo 32 caracteres)
SESSION_SECRET=pon-aqui-tu-secreto-de-32-chars-minimo
